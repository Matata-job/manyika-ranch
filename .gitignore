# Ignore
.DS_Store
*.pem

# Dependencies
node_modules/

# Next.js
.next/
out/

# Env (never commit secrets)
.env
.env*.local
!.env.example

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo

# Prisma local sqlite leftovers
/prisma/*.db
/prisma/*.db-journal

# Local uploads (use Supabase in production)
/public/uploads/*
!/public/uploads/.gitkeep

# Serwist build output
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
/public/swe-worker-*.js.map
