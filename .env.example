# =============================================================================
# Manyika Ranch — Environment Variables
# Copy to .env for local development. Set the same keys in Vercel → Settings.
# =============================================================================

# PostgreSQL (local Docker / Homebrew, or Neon / Supabase in production)
DATABASE_URL="postgresql://john@localhost:5432/app_manyika_ranch?schema=public"

# Auth.js / NextAuth (generate with: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Supabase Storage (animal photos) — required for Vercel production uploads
# Create a free project at https://supabase.com → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# Prefer service role for server-side uploads (keep secret; never expose to browser)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Optional fallback if you only have the anon key (bucket must allow uploads)
# SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_STORAGE_BUCKET="animal-photos"
